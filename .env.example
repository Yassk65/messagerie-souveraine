# Copier en .env puis adapter (facultatif : des valeurs de démo existent par défaut)
SERVER_NAME=localhost
PUBLIC_BASEURL=http://localhost:3000/matrix
# Uniquement lettres/chiffres/_ - (utilisé dans un modèle de config)
POSTGRES_PASSWORD=changeme_dev_only
PORTAL_DB_PASSWORD=portal_dev_only
# false : aucun compte fictif. Définir le mot de passe admin au premier démarrage.
DEMO_MODE=false
BOOTSTRAP_ADMIN_PASSWORD=
DEMO_PASSWORD=Demo-Fictif-2026!
# true uniquement derrière un reverse-proxy HTTPS
COOKIE_SECURE=false
